// ─── HELPER FUNCTIONS ──────────────────────────────────────────────────────
function h1(text) {
  return new Paragraph({
    heading: HeadingLevel.HEADING_1,
    children: [new TextRun({ text, font: 'Arial', size: 36, bold: true, color: C.navy })],
    spacing: { before: 480, after: 240 },
    pageBreakBefore: true,
  });
}

function h2(text) {
  return new Paragraph({
    heading: HeadingLevel.HEADING_2,
    children: [new TextRun({ text, font: 'Arial', size: 28, bold: true, color: C.navy })],
    spacing: { before: 360, after: 180 },
  });
}

function h3(text) {
  return new Paragraph({
    heading: HeadingLevel.HEADING_3,
    children: [new TextRun({ text, font: 'Arial', size: 24, bold: true, color: C.blue })],
    spacing: { before: 240, after: 120 },
  });
}

function h4(text) {
  return new Paragraph({
    heading: HeadingLevel.HEADING_4,
    children: [new TextRun({ text, font: 'Arial', size: 22, bold: true, color: C.teal })],
    spacing: { before: 180, after: 100 },
  });
}

function body(text, opts = {}) {
  return new Paragraph({
    children: [new TextRun({ text, font: 'Arial', size: 22, color: C.black, ...opts })],
    spacing: { before: 60, after: 120 },
    alignment: AlignmentType.LEFT,
  });
}

function bodyBold(label, text) {
  return new Paragraph({
    children: [
      new TextRun({ text: label + ' ', font: 'Arial', size: 22, bold: true, color: C.black }),
      new TextRun({ text, font: 'Arial', size: 22, color: C.black }),
    ],
    spacing: { before: 60, after: 120 },
  });
}

function bullet(text, level = 0, bold = false) {
  return new Paragraph({
    numbering: { reference: 'bullets', level },
    children: [new TextRun({ text, font: 'Arial', size: 22, color: C.black, bold })],
    spacing: { before: 40, after: 60 },
  });
}

function step(text) {
  return new Paragraph({
    numbering: { reference: 'steps', level: 0 },
    children: [new TextRun({ text, font: 'Arial', size: 22, color: C.black })],
    spacing: { before: 60, after: 80 },
  });
}

function substep(text) {
  return new Paragraph({
    numbering: { reference: 'substeps', level: 0 },
    children: [new TextRun({ text, font: 'Arial', size: 22, color: C.black })],
    spacing: { before: 40, after: 60 },
  });
}

function spacer(n = 1) {
  return Array(n).fill(null).map(() => new Paragraph({
    children: [new TextRun('')],
    spacing: { before: 0, after: 80 },
  }));
}

function divider() {
  return new Paragraph({
    children: [new TextRun('')],
    border: { bottom: { style: BorderStyle.SINGLE, size: 4, color: C.medGray } },
    spacing: { before: 160, after: 160 },
  });
}

function callout(label, text, color = C.teal) {
  const border = { style: BorderStyle.SINGLE, size: 1, color: C.medGray };
  const borders = { top: border, bottom: border, left: border, right: border };
  return new Table({
    width: { size: 9360, type: WidthType.DXA },
    columnWidths: [9360],
    rows: [
      new TableRow({ children: [
        new TableCell({
          borders,
          width: { size: 9360, type: WidthType.DXA },
          shading: { fill: 'F5F8FF', type: ShadingType.CLEAR },
          margins: { top: 160, bottom: 160, left: 200, right: 200 },
          children: [
            new Paragraph({ children: [new TextRun({ text: label, font: 'Arial', size: 20, bold: true, color: color })], spacing: { before: 0, after: 80 } }),
            new Paragraph({ children: [new TextRun({ text, font: 'Arial', size: 20, color: C.black })], spacing: { before: 0, after: 0 } }),
          ]
        })
      ]})
    ]
  });
}

function twoColTable(headers, rows, colWidths = [2000, 7360]) {
  const border = { style: BorderStyle.SINGLE, size: 1, color: C.medGray };
  const borders = { top: border, bottom: border, left: border, right: border };
  const hRow = new TableRow({
    children: headers.map((h, i) => new TableCell({
      borders,
      width: { size: colWidths[i], type: WidthType.DXA },
      shading: { fill: C.navy, type: ShadingType.CLEAR },
      margins: { top: 80, bottom: 80, left: 120, right: 120 },
      children: [new Paragraph({ children: [new TextRun({ text: h, font: 'Arial', size: 20, bold: true, color: C.white })], spacing: { before: 0, after: 0 } })]
    }))
  });
  const dataRows = rows.map(row => new TableRow({
    children: row.map((cell, i) => new TableCell({
      borders,
      width: { size: colWidths[i], type: WidthType.DXA },
      shading: { fill: C.white, type: ShadingType.CLEAR },
      margins: { top: 80, bottom: 80, left: 120, right: 120 },
      children: [new Paragraph({ children: [new TextRun({ text: cell, font: 'Arial', size: 20, color: C.black })], spacing: { before: 0, after: 0 } })]
    }))
  }));
  return new Table({ width: { size: 9360, type: WidthType.DXA }, columnWidths: colWidths, rows: [hRow, ...dataRows] });
}

function threeColTable(headers, rows, colWidths = [2400, 3480, 3480]) {
  const border = { style: BorderStyle.SINGLE, size: 1, color: C.medGray };
  const borders = { top: border, bottom: border, left: border, right: border };
  const hRow = new TableRow({
    children: headers.map((h, i) => new TableCell({
      borders,
      width: { size: colWidths[i], type: WidthType.DXA },
      shading: { fill: C.navy, type: ShadingType.CLEAR },
      margins: { top: 80, bottom: 80, left: 120, right: 120 },
      children: [new Paragraph({ children: [new TextRun({ text: h, font: 'Arial', size: 20, bold: true, color: C.white })], spacing: { before: 0, after: 0 } })]
    }))
  });
  const dataRows = rows.map((row, ri) => new TableRow({
    children: row.map((cell, i) => new TableCell({
      borders,
      width: { size: colWidths[i], type: WidthType.DXA },
      shading: { fill: ri % 2 === 0 ? C.white : C.ltGray, type: ShadingType.CLEAR },
      margins: { top: 80, bottom: 80, left: 120, right: 120 },
      children: [new Paragraph({ children: [new TextRun({ text: cell, font: 'Arial', size: 20, color: C.black })], spacing: { before: 0, after: 0 } })]
    }))
  }));
  return new Table({ width: { size: 9360, type: WidthType.DXA }, columnWidths: colWidths, rows: [hRow, ...dataRows] });
}

function partHeader(num, title, subtitle) {
  const border = { style: BorderStyle.SINGLE, size: 1, color: C.medGray };
  const borders = { top: border, bottom: border, left: border, right: border };
  return new Table({
    width: { size: 9360, type: WidthType.DXA },
    columnWidths: [9360],
    rows: [new TableRow({ children: [new TableCell({
      borders,
      width: { size: 9360, type: WidthType.DXA },
      shading: { fill: C.navy, type: ShadingType.CLEAR },
      margins: { top: 240, bottom: 240, left: 360, right: 360 },
      children: [
        new Paragraph({ children: [new TextRun({ text: `PART ${num}`, font: 'Arial', size: 20, bold: true, color: 'A0C4FF' })], spacing: { before: 0, after: 80 } }),
        new Paragraph({ children: [new TextRun({ text: title, font: 'Arial', size: 32, bold: true, color: C.white })], spacing: { before: 0, after: 80 } }),
        new Paragraph({ children: [new TextRun({ text: subtitle, font: 'Arial', size: 20, color: 'D0DFF0' })], spacing: { before: 0, after: 0 } }),
      ]
    })]})],
  });
