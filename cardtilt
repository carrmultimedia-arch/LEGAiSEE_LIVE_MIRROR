<body>

<div class="reflective-bg">
  <div class="glow-spotlight"></div>
  
  <div class="card-container">
    <!-- Add data-tilt attributes for JavaScript setup -->
    <div class="glass-card" data-tilt>
      <div class="glossy-shimmer"></div>
      <h3>Dashboard Overview</h3>
      <p>Welcome back to your reflective workspace.</p>
    </div>
    
    <div class="glass-card active-glow" data-tilt>
      <div class="glossy-shimmer"></div>
      <h3>Reflective System</h3>
      <p>Card UI designed with a glossy glass effect.</p>
    </div>

    <div class="glass-card" data-tilt>
      <div class="glossy-shimmer"></div>
      <h3>Analytics</h3>
      <p>System stability: 99.9% up.</p>
    </div>
  </div>
</div>
