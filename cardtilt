/* Update base layout for 3D depth perception */
.card-container {
  display: flex;
  gap: 24px;
  z-index: 10;
  padding: 20px;
  flex-wrap: wrap;
  justify-content: center;
  perspective: 1000px; /* Crucial for 3D depth */
}

/* Glass Card Styling Updates */
.glass-card {
  position: relative; /* Contain the shimmer layer */
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 30px;
  width: 250px;
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  transform-style: preserve-3d; /* Allows child elements to exist in 3D space */
  will-change: transform;
  overflow: hidden; /* Clips the moving shine effect */
}

/* Subtle moving gloss reflection */
.glossy-shimmer {
  position: absolute;
  top: 0;
  left: 0;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.06) 0%, rgba(255,255,255,0) 50%);
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 1;
}

/* Push text into 3D space relative to the tilted card */
.glass-card h3, .glass-card p {
  transform: translateZ(30px);
}
</style>
