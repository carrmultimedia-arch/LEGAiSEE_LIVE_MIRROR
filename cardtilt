<script>
const cards = document.querySelectorAll('[data-tilt]');

cards.forEach(card => {
  const shimmer = card.querySelector('.glossy-shimmer');
  
  card.addEventListener('mousemove', (e) => {
    const rect = card.getBoundingClientRect();
    const x = e.clientX - rect.left; // Mouse X inside card
    const y = e.clientY - rect.top;  // Mouse Y inside card
    
    // Calculate rotation (-15deg to 15deg)
    const rotateX = ((y / rect.height) - 0.5) * -30;
    const rotateY = ((x / rect.width) - 0.5) * 30;
    
    // Update transform matrix
    card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    
    // Update gloss shimmer coordinates
    if (shimmer) {
      shimmer.style.setProperty('--mouse-x', `${(x / rect.width) * 100}%`);
      shimmer.style.setProperty('--mouse-y', `${(y / rect.height) * 100}%`);
    }
  });

  // Reset positioning on leave
  card.addEventListener('mouseleave', () => {
    card.style.transform = 'rotateX(0deg) rotateY(0deg)';
    card.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)';
  });

  card.addEventListener('mouseenter', () => {
    card.style.transition = 'none'; // Snappy track on enter
  });
});
</script>
