<script>
/* ================================================================
   SCROLL LIGHTING ENGINE
   ================================================================

   LIGHT_MAP — define light sources in page space.
   Each entry:
     id       — identifier shown in debug panel
     xPct     — horizontal position as % of page width (0–100)
     yPx      — vertical position in px from document top
               (set after DOM is ready, using section offsets below)
     radius   — influence radius in px (soft edge, not hard clip)
     intensity — peak brightness at center (0–1)

   yPx values tagged [DYNAMIC] are resolved from DOM measurements
   below, so they survive viewport changes and don't need to be
   hand-coded against a specific screen height.
================================================================ */

const LIGHT_MAP = [
  { id:'L1', label:'Entry · top-left',     xPct:18, yPx:null, anchorSel:'#s01', anchorPct:0.25, radius:580, intensity:0.82 },
  { id:'L2', label:'Dig · bottom-right',   xPct:82, yPx:null, anchorSel:'#s02', anchorPct:0.80, radius:500, intensity:0.70 },
  { id:'L3', label:'Alchemy · top-center', xPct:50, yPx:null, anchorSel:'#s03', anchorPct:0.20, radius:640, intensity:0.90 },
  { id:'L4', label:'Practitioner · left',  xPct:22, yPx:null, anchorSel:'#s04', anchorPct:0.50, radius:460, intensity:0.75 },
  { id:'L5', label:'Industries · right',   xPct:80, yPx:null, anchorSel:'#s05', anchorPct:0.15, radius:420, intensity:0.68 },
  { id:'L6', label:'Close · center-warm',  xPct:50, yPx:null, anchorSel:'#s06', anchorPct:0.60, radius:600, intensity:0.85 },
];

// Assign section IDs to zones for anchor resolution
document.querySelectorAll('.zone').forEach((z, i) => z.id = `s0${i+1}`);

// Gather all elements that should respond to lighting
const litEls = document.querySelectorAll('.lit-element, .img-placeholder, .pullout');

// Controls
const intensityScaleSlider = document.getElementById('intensityScale');
const falloffSlider        = document.getElementById('falloff');
const showLightsCB         = document.getElementById('showLights');
const showValuesCB         = document.getElementById('showValues');
const flatGoldCB           = document.getElementById('flatGold');

let intensityScale = 1.0;
let falloffPow     = 1.8;
let frameScheduled = false;

/* ----------------------------------------------------------
   RESOLVE LIGHT Y POSITIONS from DOM
   ---------------------------------------------------------- */
function resolveLightPositions(){
  LIGHT_MAP.forEach(L => {
    const anchor = document.querySelector(L.anchorSel);
    if(!anchor) return;
    const rect = anchor.getBoundingClientRect();
    const scrollY = window.scrollY || window.pageYOffset;
    const sectionTop    = rect.top + scrollY;
    const sectionHeight = rect.height;
    L.yPx = sectionTop + sectionHeight * L.anchorPct;
  });
  buildLightMarkers();
  buildLightPills();
}

/* ----------------------------------------------------------
   DEBUG — LIGHT MARKERS in DOM
   ---------------------------------------------------------- */
function buildLightMarkers(){
  const container = document.getElementById('light-markers');
  container.innerHTML = '';
  LIGHT_MAP.forEach(L => {
    const m = document.createElement('div');
    m.className = 'light-marker';
    m.style.cssText = `position:absolute; left:${L.xPct}%; top:${L.yPx}px; --lm-r:${L.radius * 2}px;`;
    m.innerHTML = `
      <div class="ring"></div>
      <div class="dot"></div>
      <div class="lm-label">${L.id} · ${L.label}</div>`;
    container.appendChild(m);
  });
}

/* ----------------------------------------------------------
   DEBUG — LIGHT PILLS in panel
   ---------------------------------------------------------- */
function buildLightPills(){
  const container = document.getElementById('light-pills');
  container.innerHTML = '';
  LIGHT_MAP.forEach(L => {
    const p = document.createElement('div');
    p.className = 'light-pill';
    p.innerHTML = `<div class="swatch"></div>
      <span>${L.id} — ${L.label}<br>x:${L.xPct}% · r:${L.radius}px</span>`;
    container.appendChild(p);
  });
}

/* ----------------------------------------------------------
   CORE ENGINE — called every animation frame on scroll
   ---------------------------------------------------------- */
function calcBrightness(elCenterY, elCenterXPct, light){
  // Distance in px — treat x as equivalent-px using viewport width
  const vw = window.innerWidth;
  const dy = elCenterY - light.yPx;
  const dx = (elCenterXPct - light.xPct) / 100 * vw;
  const dist = Math.sqrt(dx*dx + dy*dy);

  if(dist >= light.radius) return { b:0, x:light.xPct };

  // Inverse-square-ish falloff, shaped by falloffPow slider
  const t = 1 - (dist / light.radius);
  const b = Math.pow(t, falloffPow) * light.intensity * intensityScale;
  return { b: Math.min(b, 1), x: light.xPct, dx, dy };
}

function updateLighting(){
  frameScheduled = false;
  const scrollY = window.scrollY || window.pageYOffset;
  const vw = window.innerWidth;

  litEls.forEach(el => {
    const rect = el.getBoundingClientRect();
    // Skip if completely off screen — small perf win on long pages
    if(rect.bottom < -200 || rect.top > window.innerHeight + 200) return;

    const elCenterY    = rect.top + scrollY + rect.height * 0.5;
    const elCenterXPct = ((rect.left + rect.width * 0.5) / vw) * 100;

    // Accumulate contributions from all lights
    let totalB  = 0;
    let weightedX = 0;
    let totalW  = 0;

    LIGHT_MAP.forEach(L => {
      if(L.yPx === null) return;
      const { b, x } = calcBrightness(elCenterY, elCenterXPct, L);
      totalB     += b;
      weightedX  += x * b;
      totalW     += b;
    });

    totalB = Math.min(totalB, 1);
    const dominantX = totalW > 0.001 ? weightedX / totalW : 50;

    // Foil angle: light coming from left → shallow angle; from right → steep
    const foilAngle = Math.round(70 + (dominantX / 100) * 80);

    el.style.setProperty('--el-brightness', totalB.toFixed(3));
    el.style.setProperty('--el-top-x', dominantX.toFixed(1) + '%');
    el.style.setProperty('--el-foil-angle', foilAngle + 'deg');

    if(showValuesCB && showValuesCB.checked){
      el.dataset.dbgB = totalB.toFixed(2);
      el.title = `brightness:${totalB.toFixed(2)} x:${dominantX.toFixed(0)}% angle:${foilAngle}°`;
    } else {
      el.title = '';
    }
  });
}

function scheduleFrame(){
  if(!frameScheduled){
    frameScheduled = true;
    requestAnimationFrame(updateLighting);
  }
}

/* ----------------------------------------------------------
   CONTROLS
   ---------------------------------------------------------- */
intensityScaleSlider.addEventListener('input', () => {
  intensityScale = intensityScaleSlider.value / 100;
  scheduleFrame();
});
falloffSlider.addEventListener('input', () => {
  falloffPow = falloffSlider.value / 10;
  scheduleFrame();
});
showLightsCB.addEventListener('change', () => {
  document.body.classList.toggle('show-lights', showLightsCB.checked);
});
flatGoldCB.addEventListener('change', () => {
  document.body.classList.toggle('flat-gold', flatGoldCB.checked);
});

/* ----------------------------------------------------------
   INIT + EVENT BINDING
   ---------------------------------------------------------- */
window.addEventListener('scroll', scheduleFrame, { passive:true });
window.addEventListener('resize', () => { resolveLightPositions(); scheduleFrame(); });

// Resolve positions after fonts/layout settle
if(document.fonts && document.fonts.ready){
  document.fonts.ready.then(() => { resolveLightPositions(); scheduleFrame(); });
} else {
  resolveLightPositions();
  scheduleFrame();
}
// Belt-and-suspenders: also resolve after a short delay in case of late layout shifts
setTimeout(() => { resolveLightPositions(); scheduleFrame(); }, 400);

</script>
