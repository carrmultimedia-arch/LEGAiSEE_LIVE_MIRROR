/* ═══════════════════════════════════════════════════════════════════════════════
   SECTION: PROCESS TIMELINE — Gemstone Stages
   ═══════════════════════════════════════════════════════════════════════════════ */
.l-process {
  padding: var(--space-xl) var(--space-md);
}

.l-process__header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto var(--space-xl);
}

.l-process__timeline {
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
}

.l-process__timeline::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1px;
  background: linear-gradient(to bottom, transparent, var(--l-gold-deep), transparent);
  transform: translateX(-50%);
}

.l-process__stage {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-xl);
  align-items: center;
  margin-bottom: var(--space-xl);
  position: relative;
}

.l-process__stage:nth-child(even) .l-process__text {
  order: 2;
}

.l-process__stage:nth-child(even) .l-process__visual {
  order: 1;
  text-align: right;
}

.l-process__dot {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--l-black-primary);
  border: 2px solid var(--l-gold-bright);
  box-shadow: 0 0 20px rgba(255,199,44,0.3);
  z-index: 10;
}

.l-process__dot::before {
  content: "";
  position: absolute;
  inset: -8px;
  border-radius: 50%;
  border: 1px solid rgba(255,199,44,0.2);
}

.l-process__number {
  font-family: var(--font-display);
  font-size: 0.75rem;
  color: var(--l-gold-dim);
  letter-spacing: 0.2em;
  margin-bottom: var(--space-xs);
}

.l-process__title {
  margin-bottom: var(--space-sm);
}

.l-process__desc {
  color: var(--l-white-dim);
  margin-bottom: var(--space-sm);
}

.l-process__visual {
  position: relative;
}

.l-process__visual img {
  max-width: 100%;
  max-height: 350px;
  object-fit: contain;
  border-radius: 4px;
}

.l-process__visual-frame {
  position: relative;
  display: inline-block;
  padding: 12px;
  border: 1px solid rgba(255,199,44,0.1);
  background: rgba(26,26,26,0.5);
}

.l-process__visual-frame::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--grad-gold-linear);
  opacity: 0.3;
}

.l-process__gem-label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--l-gold-dim);
  margin-top: var(--space-xs);
  text-align: center;
}

@media (max-width: 900px) {
  .l-process__timeline::before {
    left: 20px;
  }
  .l-process__stage {
    grid-template-columns: 1fr;
    padding-left: 50px;
  }
  .l-process__stage:nth-child(even) .l-process__text,
  .l-process__stage:nth-child(even) .l-process__visual {
    order: unset;
    text-align: left;
  }
  .l-process__dot {
    left: 20px;
  }
}

