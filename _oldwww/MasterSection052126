
/* ═══════════════════════════════════════════════════════════════════════════════
part1_css = '''   
LEGAISEE MASTER SECTION LIBRARY v2.1 — PART 1 of 5
   CSS Foundation: Design Tokens, Reset, Background System, Typography
   Target: $50M+ Revenue Corporate Executives
   Tone: Rolls Royce · Rolex · NASA · Speakeasy Authority
   ═══════════════════════════════════════════════════════════════════════════════ */

/* ──────────────────────────────────────────────────────────────────────────────
   DESIGN TOKENS — Gemstone & Museum Palette
   ────────────────────────────────────────────────────────────────────────────── */
:root {
  /* Core Blacks (Formation → Depth) */
  --l-black-primary:   #080808;
  --l-black-deep:    #0a0a0a;
  --l-black-void:    #050505;
  --l-black-surface: #111111;
  
  /* Shadow Tones (Cave Depth) */
  --l-brown-shadow:  #2D231E;
  --l-brown-warm:    #3D2F28;
  --l-bronze-mid:    #604A3C;
  --l-bronze-dim:    #4A3A30;
  
  /* Card Surfaces (Refinement Studio) */
  --l-grey-card:     #1A1A1A;
  --l-grey-elevated: #222222;
  --l-grey-border:   #2A2A2A;
  
  /* Gold System (Prestige Display) */
  --l-gold-bright:   #FFC72C;
  --l-gold-rich:     #D4AF37;
  --l-gold-deep:     #B8860B;
  --l-gold-dim:      #8B6914;
  --l-gold-pale:     #C9A84C;
  
  /* Violet Accents (Museum Drama) */
  --l-violet-deep:   #1a0a2e;
  --l-violet-mid:    #2d1b4e;
  --l-violet-glow:   #4a2c7a;
  --l-violet-bright: #7B5BA8;
  
  /* Text Hierarchy */
  --l-white-pure:    #FFFFFF;
  --l-white-warm:    #E0E0C0;
  --l-white-dim:     #B0B0A0;
  --l-white-muted:   #888870;
  
  /* Gradients */
  --grad-gold-linear: linear-gradient(135deg, #FFD700 0%, #B8860B 50%, #FFC72C 100%);
  --grad-gold-radial: radial-gradient(ellipse at 50% 30%, rgba(255,199,44,0.15) 0%, transparent 70%);
  --grad-violet-radial: radial-gradient(ellipse at 50% 50%, rgba(74,44,122,0.25) 0%, rgba(26,10,46,0.6) 50%, rgba(8,8,8,0.95) 100%);
  --grad-black-radial: radial-gradient(ellipse at 50% 100%, rgba(45,35,30,0.4) 0%, rgba(8,8,8,0.98) 60%);
  --grad-shine-sweep: linear-gradient(90deg, transparent 0%, rgba(255,199,44,0.08) 50%, transparent 100%);
  
  /* Shadows */
  --shadow-gold-soft: 0 0 40px rgba(255,199,44,0.08);
  --shadow-gold-hard: 0 0 60px rgba(255,199,44,0.15), 0 4px 20px rgba(0,0,0,0.8);
  --shadow-depth: 0 20px 60px rgba(0,0,0,0.9), 0 0 0 1px rgba(255,199,44,0.05);
  
  /* Spacing */
  --space-xs: 0.5rem;
  --space-sm: 1rem;
  --space-md: 2rem;
  --space-lg: 4rem;
  --space-xl: 8rem;
  --space-xxl: 12rem;
  
  /* Typography */
  --font-display: "Cinzel", "Playfair Display", Georgia, serif;
  --font-body: "Montserrat", "Inter", system-ui, sans-serif;
  --font-mono: "JetBrains Mono", "Fira Code", monospace;
  
  /* Transitions */
  --ease-luxury: cubic-bezier(0.23, 1, 0.32, 1);
  --ease-snap: cubic-bezier(0.68, -0.15, 0.265, 1.15);
  
  /* Z-Index Scale */
  --z-bg: -10;
  --z-content: 10;
  --z-overlay: 50;
  --z-modal: 100;
  --z-nav: 200;
}

/* ──────────────────────────────────────────────────────────────────────────────
   RESET + BASE
   ────────────────────────────────────────────────────────────────────────────── */
*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-body);
  background: var(--l-black-primary);
  color: var(--l-white-warm);
  line-height: 1.7;
  overflow-x: hidden;
  min-height: 100vh;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: var(--l-gold-bright);
  text-decoration: none;
  transition: color 0.3s var(--ease-luxury);
}

a:hover {
  color: var(--l-white-pure);
}

::selection {
  background: rgba(255,199,44,0.25);
  color: var(--l-white-pure);
}

/* ──────────────────────────────────────────────────────────────────────────────
   BACKGROUND SYSTEM — 4 Options Per Section
   ────────────────────────────────────────────────────────────────────────────── */

/* Option A: Solid Color Backgrounds */
.bg-solid-black    { background-color: var(--l-black-primary); }
.bg-solid-void     { background-color: var(--l-black-void); }
.bg-solid-surface  { background-color: var(--l-black-surface); }
.bg-solid-card     { background-color: var(--l-grey-card); }
.bg-solid-bronze   { background-color: var(--l-bronze-mid); }

/* Option B: Gradient Backgrounds */
.bg-grad-gold-radial {
  background: var(--l-black-primary);
  background-image: var(--grad-gold-radial);
  background-attachment: fixed;
}

.bg-grad-violet-radial {
  background: var(--l-black-primary);
  background-image: var(--grad-violet-radial);
  background-attachment: fixed;
}

.bg-grad-black-radial {
  background: var(--l-black-primary);
  background-image: var(--grad-black-radial);
}

.bg-grad-formation {
  background: 
    radial-gradient(ellipse at 20% 80%, rgba(96,74,60,0.15) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(255,199,44,0.05) 0%, transparent 40%),
    var(--l-black-primary);
}

/* Option C: Photo Backgrounds (Museum, Gemstone Stages) */
.bg-photo-museum {
  background: var(--l-black-primary);
  position: relative;
}

.bg-photo-museum::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url("/assets/bg-museum-vault.jpg");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  opacity: 0.12;
  z-index: var(--z-bg);
  filter: saturate(0.3) contrast(1.2);
}

.bg-photo-formation {
  position: relative;
  background: var(--l-black-void);
}

.bg-photo-formation::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url("/assets/bg-formation-mine.jpg");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  opacity: 0.08;
  z-index: var(--z-bg);
  filter: saturate(0.2) contrast(1.3);
}

.bg-photo-discovery {
  position: relative;
  background: var(--l-black-primary);
}

.bg-photo-discovery::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url("/assets/bg-discovery-vault.jpg");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  opacity: 0.1;
  z-index: var(--z-bg);
  filter: saturate(0.25) contrast(1.2);
}

.bg-photo-refinement {
  position: relative;
  background: var(--l-black-deep);
}

.bg-photo-refinement::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url("/assets/bg-refinement-studio.jpg");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  opacity: 0.09;
  z-index: var(--z-bg);
  filter: saturate(0.15) contrast(1.4);
}

.bg-photo-prestige {
  position: relative;
  background: var(--l-black-void);
}

.bg-photo-prestige::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url("/assets/bg-prestige-exhibit.jpg");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  opacity: 0.1;
  z-index: var(--z-bg);
  filter: saturate(0.3) contrast(1.2);
}

/* Option D: Pattern/Texture Overlays */
.bg-pattern-grid {
  background: var(--l-black-primary);
  background-image: 
    linear-gradient(rgba(255,199,44,0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,199,44,0.015) 1px, transparent 1px);
  background-size: 60px 60px;
}

.bg-pattern-dots {
  background: var(--l-black-primary);
  background-image: radial-gradient(rgba(255,199,44,0.03) 1px, transparent 1px);
  background-size: 30px 30px;
}

/* ──────────────────────────────────────────────────────────────────────────────
   SECTION BASE — All Sections Inherit
   ────────────────────────────────────────────────────────────────────────────── */
.l-section {
  position: relative;
  width: 100%;
  padding: var(--space-xl) var(--space-md);
  overflow: hidden;
}

.l-section > * {
  position: relative;
  z-index: var(--z-content);
}

.l-section--narrow {
  max-width: 1200px;
  margin: 0 auto;
}

.l-section--wide {
  max-width: 1400px;
  margin: 0 auto;
}

.l-section--full {
  max-width: 100%;
}

/* Seamless transitions: section bottom color must match next section top */
.l-section--seamless-next-black {
  padding-bottom: var(--space-xl);
}

.l-section--seamless-next-violet {
  padding-bottom: var(--space-xl);
}

.l-section--seamless-next-gold {
  padding-bottom: var(--space-xl);
}

/* ──────────────────────────────────────────────────────────────────────────────
   TYPOGRAPHY — Museum Exhibit Quality
   ────────────────────────────────────────────────────────────────────────────── */
.l-h1 {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 6vw, 5rem);
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--l-gold-bright);
  text-shadow: 0 2px 40px rgba(255,199,44,0.15);
}

.l-h1--gradient {
  background: var(--grad-gold-linear);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.l-h2 {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 3.2rem);
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: -0.01em;
  color: var(--l-gold-bright);
}

.l-h3 {
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 2.5vw, 2rem);
  font-weight: 400;
  line-height: 1.25;
  color: var(--l-gold-pale);
}

.l-h4 {
  font-family: var(--font-body);
  font-size: clamp(1rem, 1.5vw, 1.25rem);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--l-gold-dim);
}

.l-body {
  font-family: var(--font-body);
  font-size: clamp(1rem, 1.2vw, 1.125rem);
  line-height: 1.8;
  color: var(--l-white-warm);
  max-width: 65ch;
}

.l-body--dim {
  color: var(--l-white-dim);
}

.l-caption {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--l-gold-dim);
}

.l-quote {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 3vw, 2.5rem);
  font-style: italic;
  line-height: 1.4;
  color: var(--l-white-warm);
  border-left: 2px solid var(--l-gold-deep);
  padding-left: var(--space-md);
  margin: var(--space-lg) 0;
}

/* ──────────────────────────────────────────────────────────────────────────────
   GOLD ACCENT ELEMENTS
   ────────────────────────────────────────────────────────────────────────────── */
.l-gold-rule {
  width: 80px;
  height: 2px;
  background: var(--grad-gold-linear);
  margin: var(--space-sm) 0 var(--space-md);
}

.l-gold-rule--wide {
  width: 120px;
}

.l-gold-rule--center {
  margin-left: auto;
  margin-right: auto;
}

.l-gold-glow {
  box-shadow: var(--shadow-gold-soft);
}

.l-gold-border {
  border: 1px solid rgba(255,199,44,0.15);
}

.l-gold-border--strong {
  border: 1px solid rgba(255,199,44,0.3);
}

/* ──────────────────────────────────────────────────────────────────────────────
   ANIMATION UTILITIES
   ────────────────────────────────────────────────────────────────────────────── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(40px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes shimmer {
  0%   { background-position: -200% center; }
  100% { background-position: 200% center; }
}

@keyframes pulseGold {
  0%, 100% { box-shadow: 0 0 20px rgba(255,199,44,0.05); }
  50%      { box-shadow: 0 0 40px rgba(255,199,44,0.15); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-10px); }
}

.l-animate-fadeup {
  animation: fadeUp 0.8s var(--ease-luxury) forwards;
}

.l-animate-fadein {
  animation: fadeIn 1s ease forwards;
}

.l-animate-shimmer {
  background: linear-gradient(90deg, transparent, rgba(255,199,44,0.05), transparent);
  background-size: 200% 100%;
  animation: shimmer 3s infinite;
}

.l-animate-pulse-gold {
  animation: pulseGold 3s ease-in-out infinite;
}

.l-animate-float {
  animation: float 6s ease-in-out infinite;
}

/* Stagger delays */
.l-delay-1 { animation-delay: 0.1s; }
.l-delay-2 { animation-delay: 0.2s; }
.l-delay-3 { animation-delay: 0.3s; }
.l-delay-4 { animation-delay: 0.4s; }
.l-delay-5 { animation-delay: 0.5s; }

/* ──────────────────────────────────────────────────────────────────────────────
   BUTTONS — Museum Switch Aesthetic
   ────────────────────────────────────────────────────────────────────────────── */
.l-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  padding: 1rem 2.5rem;
  font-family: var(--font-body);
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border: 1px solid var(--l-gold-deep);
  background: transparent;
  color: var(--l-gold-bright);
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: all 0.4s var(--ease-luxury);
}

.l-btn::before {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--grad-gold-linear);
  opacity: 0;
  transition: opacity 0.4s var(--ease-luxury);
  z-index: -1;
}

.l-btn:hover {
  color: var(--l-black-primary);
  border-color: var(--l-gold-bright);
  transform: translateY(-2px);
  box-shadow: var(--shadow-gold-hard);
}

.l-btn:hover::before {
  opacity: 1;
}

.l-btn--solid {
  background: var(--grad-gold-linear);
  color: var(--l-black-primary);
  border-color: var(--l-gold-bright);
}

.l-btn--solid:hover {
  background: transparent;
  color: var(--l-gold-bright);
}

.l-btn--small {
  padding: 0.625rem 1.5rem;
  font-size: 0.75rem;
}

/* ──────────────────────────────────────────────────────────────────────────────
   CARDS — Artifact Display Cases
   ────────────────────────────────────────────────────────────────────────────── */
.l-card {
  background: var(--l-grey-card);
  border: 1px solid rgba(255,199,44,0.08);
  padding: var(--space-md);
  position: relative;
  overflow: hidden;
  transition: all 0.5s var(--ease-luxury);
}

.l-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: var(--grad-shine-sweep);
  transition: left 0.8s var(--ease-luxury);
  pointer-events: none;
}

.l-card:hover {
  border-color: rgba(255,199,44,0.25);
  box-shadow: var(--shadow-depth);
  transform: translateY(-4px);
}

.l-card:hover::before {
  left: 100%;
}

.l-card--featured {
  background: linear-gradient(135deg, var(--l-grey-card) 0%, rgba(45,35,30,0.3) 100%);
  border: 1px solid rgba(255,199,44,0.15);
}

.l-card--glass {
  background: rgba(26,26,26,0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,199,44,0.1);
}

/* ──────────────────────────────────────────────────────────────────────────────
   GRID SYSTEM
   ────────────────────────────────────────────────────────────────────────────── */
.l-grid {
  display: grid;
  gap: var(--space-md);
}

.l-grid--2 { grid-template-columns: repeat(2, 1fr); }
.l-grid--3 { grid-template-columns: repeat(3, 1fr); }
.l-grid--4 { grid-template-columns: repeat(4, 1fr); }

@media (max-width: 1024px) {
  .l-grid--4 { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .l-grid--2,
  .l-grid--3,
  .l-grid--4 { grid-template-columns: 1fr; }
  
  .l-section {
    padding: var(--space-lg) var(--space-sm);
  }
}

/* ──────────────────────────────────────────────────────────────────────────────
   UTILITY CLASSES
   ────────────────────────────────────────────────────────────────────────────── */
.l-text-center { text-align: center; }
.l-text-left   { text-align: left; }
.l-text-right  { text-align: right; }

.l-mb-sm { margin-bottom: var(--space-sm); }
.l-mb-md { margin-bottom: var(--space-md); }
.l-mb-lg { margin-bottom: var(--space-lg); }
.l-mb-xl { margin-bottom: var(--space-xl); }

.l-mt-sm { margin-top: var(--space-sm); }
.l-mt-md { margin-top: var(--space-md); }
.l-mt-lg { margin-top: var(--space-lg); }
.l-mt-xl { margin-top: var(--space-xl); }

.l-flex { display: flex; }
.l-flex-col { flex-direction: column; }
.l-items-center { align-items: center; }
.l-justify-center { justify-content: center; }
.l-gap-sm { gap: var(--space-sm); }
.l-gap-md { gap: var(--space-md); }
.l-gap-lg { gap: var(--space-lg); }

.l-relative { position: relative; }
.l-hidden { display: none; }

/* ──────────────────────────────────────────────────────────────────────────────
   END PART 1 — CSS Foundation Complete
   Next: Part 2 (Navigation + Hero Sections)
   ────────────────────────────────────────────────────────────────────────────── */
'''


/* ═══════════════════════════════════════════════════════════════════════════════
  part2_css = ''' LEGAISEE MASTER SECTION LIBRARY v2.1 — PART 2 of 5
   Sections: Navigation · Hero · Authority Strip · Process Timeline
   ═══════════════════════════════════════════════════════════════════════════════ */

/* ═══════════════════════════════════════════════════════════════════════════════
   SECTION: NAVIGATION — The Vault Door
   ═══════════════════════════════════════════════════════════════════════════════ */
.l-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-nav);
  padding: var(--space-sm) var(--space-md);
  background: rgba(8,8,8,0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,199,44,0.06);
  transition: all 0.4s var(--ease-luxury);
}

.l-nav--scrolled {
  background: rgba(8,8,8,0.95);
  border-bottom-color: rgba(255,199,44,0.12);
  box-shadow: 0 4px 30px rgba(0,0,0,0.5);
}

.l-nav__inner {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.l-nav__logo {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 400;
  color: var(--l-gold-bright);
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.l-nav__logo span {
  color: var(--l-white-dim);
  font-size: 0.65rem;
  display: block;
  letter-spacing: 0.3em;
  margin-top: 2px;
}

.l-nav__links {
  display: flex;
  gap: var(--space-lg);
  list-style: none;
}

.l-nav__links a {
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--l-white-dim);
  position: relative;
  padding: 0.5rem 0;
}

.l-nav__links a::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 1px;
  background: var(--grad-gold-linear);
  transition: width 0.4s var(--ease-luxury);
}

.l-nav__links a:hover {
  color: var(--l-gold-bright);
}

.l-nav__links a:hover::after {
  width: 100%;
}

.l-nav__cta {
  font-size: 0.75rem;
  padding: 0.625rem 1.5rem;
}

.l-nav__mobile-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 5px;
}

.l-nav__mobile-toggle span {
  display: block;
  width: 24px;
  height: 1.5px;
  background: var(--l-gold-bright);
  transition: all 0.3s var(--ease-luxury);
}

@media (max-width: 900px) {
  .l-nav__links,
  .l-nav__cta { display: none; }
  .l-nav__mobile-toggle { display: flex; }
}

/* ═══════════════════════════════════════════════════════════════════════════════
   SECTION: HERO — The Treasury Hall
   ═══════════════════════════════════════════════════════════════════════════════ */
.l-hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: calc(var(--space-xl) * 2) var(--space-md);
  position: relative;
}

.l-hero__content {
  max-width: 900px;
  position: relative;
  z-index: var(--z-content);
}

.l-hero__eyebrow {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--l-gold-dim);
  margin-bottom: var(--space-md);
  display: inline-block;
  padding: 0.5rem 1.5rem;
