  bottom: -1px;
  right: -1px;
  border-bottom: 2px solid var(--l-gold-deep);
  border-right: 2px solid var(--l-gold-deep);
}

.l-cta__eyebrow {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--l-gold-dim);
  margin-bottom: var(--space-md);
}

.l-cta__title {
  margin-bottom: var(--space-md);
}

.l-cta__body {
  font-size: 1.1rem;
  color: var(--l-white-dim);
  max-width: 600px;
  margin: 0 auto var(--space-lg);
  line-height: 1.7;
}

.l-cta__buttons {
  display: flex;
  gap: var(--space-md);
  justify-content: center;
  flex-wrap: wrap;
}

.l-cta__note {
  margin-top: var(--space-md);
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  color: var(--l-white-muted);
}

/* ═══════════════════════════════════════════════════════════════════════════════
   SECTION: FAQ — The Knowledge Vault
   ═══════════════════════════════════════════════════════════════════════════════ */
.l-faq {
  padding: var(--space-xl) var(--space-md);
}

.l-faq__header {
  text-align: center;
  max-width: 600px;
  margin: 0 auto var(--space-xl);
}

.l-faq__list {
  max-width: 800px;
  margin: 0 auto;
}

.l-faq__item {
  border-bottom: 1px solid rgba(255,199,44,0.06);
  overflow: hidden;
}

.l-faq__question {
  width: 100%;
  padding: var(--space-md) 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
  font-family: var(--font-body);
  font-size: 1.05rem;
  font-weight: 500;
  color: var(--l-white-warm);
  transition: color 0.3s var(--ease-luxury);
}

.l-faq__question:hover {
  color: var(--l-gold-bright);
}

.l-faq__icon {
  width: 24px;
  height: 24px;
  position: relative;
  flex-shrink: 0;
  margin-left: var(--space-sm);
}

.l-faq__icon::before,
.l-faq__icon::after {
  content: "";
  position: absolute;
  background: var(--l-gold-dim);
  transition: all 0.3s var(--ease-luxury);
}

.l-faq__icon::before {
  top: 50%;
  left: 0;
  right: 0;
  height: 1.5px;
  transform: translateY(-50%);
}

.l-faq__icon::after {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1.5px;
  transform: translateX(-50%);
}

.l-faq__item.is-open .l-faq__icon::after {
  transform: translateX(-50%) rotate(90deg);
  opacity: 0;
}

.l-faq__answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.5s var(--ease-luxury), padding 0.5s var(--ease-luxury);
}

.l-faq__item.is-open .l-faq__answer {
  max-height: 500px;
  padding-bottom: var(--space-md);
}

.l-faq__answer p {
  color: var(--l-white-dim);
  line-height: 1.7;
  font-size: 0.95rem;
}

/* ═══════════════════════════════════════════════════════════════════════════════
   SECTION: FOOTER — The Foundation Stone
   ═══════════════════════════════════════════════════════════════════════════════ */
.l-footer {
  padding: var(--space-xl) var(--space-md) var(--space-lg);
  border-top: 1px solid rgba(255,199,44,0.06);
}

.l-footer__inner {
  max-width: 1200px;
  margin: 0 auto;
}

.l-footer__top {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: var(--space-xl);
  margin-bottom: var(--space-xl);
}

.l-footer__brand {
  max-width: 300px;
}

.l-footer__logo {
  font-family: var(--font-display);
  font-size: 1.5rem;
  color: var(--l-gold-bright);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: var(--space-sm);
}

.l-footer__tagline {
  font-size: 0.9rem;
  color: var(--l-white-dim);
  line-height: 1.6;
  margin-bottom: var(--space-md);
}

.l-footer__social {
  display: flex;
  gap: var(--space-sm);
}

.l-footer__social a {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,199,44,0.1);
  transition: all 0.3s var(--ease-luxury);
}

.l-footer__social a:hover {
  border-color: var(--l-gold-bright);
  background: rgba(255,199,44,0.05);
}

.l-footer__social svg {
  width: 18px;
  height: 18px;
  stroke: var(--l-gold-dim);
  fill: none;
  stroke-width: 1.5;
}

.l-footer__col-title {
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--l-gold-pale);
  margin-bottom: var(--space-md);
}

.l-footer__links {
  list-style: none;
}

.l-footer__links li {
  margin-bottom: 0.75rem;
}

.l-footer__links a {
  font-size: 0.9rem;
  color: var(--l-white-dim);
  transition: color 0.3s var(--ease-luxury);
}

.l-footer__links a:hover {
  color: var(--l-gold-bright);
}

.l-footer__bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--space-lg);
  border-top: 1px solid rgba(255,199,44,0.04);
}

.l-footer__copyright {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--l-white-muted);
  letter-spacing: 0.05em;
}

.l-footer__legal {
  display: flex;
  gap: var(--space-md);
}

.l-footer__legal a {
  font-size: 0.8rem;
  color: var(--l-white-muted);
}

@media (max-width: 900px) {
  .l-footer__top {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 600px) {
  .l-footer__top {
    grid-template-columns: 1fr;
  }
  .l-footer__bottom {
    flex-direction: column;
    gap: var(--space-sm);
    text-align: center;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════════
   NEW SECTION: MUSEUM VAULT — Immersive Background Showcase
   Purpose: Full-bleed museum atmosphere for high-impact moments
   ═══════════════════════════════════════════════════════════════════════════════ */
.l-museum-vault {
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: var(--space-xl) var(--space-md);
  overflow: hidden;
}

.l-museum-vault__bg {
  position: absolute;
  inset: 0;
  background-image: url("/assets/bg-museum-vault.jpg");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  opacity: 0.15;
  filter: saturate(0.2) contrast(1.3);
  z-index: var(--z-bg);
}

.l-museum-vault__overlay {
  position: absolute;
  inset: 0;
  background: 
    radial-gradient(ellipse at 30% 70%, rgba(45,35,30,0.3) 0%, transparent 50%),
    radial-gradient(ellipse at 70% 30%, rgba(255,199,44,0.03) 0%, transparent 40%),
    linear-gradient(to bottom, rgba(8,8,8,0.7), rgba(8,8,8,0.9));
  z-index: 0;
}

.l-museum-vault__content {
  position: relative;
  z-index: var(--z-content);
  max-width: 900px;
  text-align: center;
}

.l-museum-vault__eyebrow {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--l-gold-dim);
  margin-bottom: var(--space-md);
  padding: 0.5rem 1.5rem;
  border: 1px solid rgba(255,199,44,0.1);
  display: inline-block;
}

.l-museum-vault__title {
  font-size: clamp(2rem, 5vw, 4rem);
  margin-bottom: var(--space-md);
}

.l-museum-vault__body {
  font-size: 1.15rem;
  color: var(--l-white-dim);
  max-width: 650px;
  margin: 0 auto var(--space-lg);
  line-height: 1.8;
}

.l-museum-vault__cta {
  margin-top: var(--space-md);
}

/* ═══════════════════════════════════════════════════════════════════════════════
   NEW SECTION: ARTIFACT GALLERY — Horizontal Scroll Showcase
   Purpose: Display case aesthetic for portfolio/assets
   ═══════════════════════════════════════════════════════════════════════════════ */
.l-artifact-gallery {
  padding: var(--space-xl) 0;
  overflow: hidden;
}

.l-artifact-gallery__header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto var(--space-xl);
  padding: 0 var(--space-md);
}

.l-artifact-gallery__track {
  display: flex;
  gap: var(--space-md);
  padding: 0 var(--space-md);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding-bottom: var(--space-md);
}

.l-artifact-gallery__track::-webkit-scrollbar {
  display: none;
}

.l-artifact-card {
  flex: 0 0 380px;
  scroll-snap-align: start;
  background: var(--l-grey-card);
  border: 1px solid rgba(255,199,44,0.06);
  position: relative;
  overflow: hidden;
  transition: all 0.5s var(--ease-luxury);
}

.l-artifact-card:hover {
  border-color: rgba(255,199,44,0.2);
  transform: translateY(-6px);
  box-shadow: var(--shadow-depth);
}

.l-artifact-card__frame {
  position: relative;
  padding: 16px;
  background: rgba(8,8,8,0.5);
}

.l-artifact-card__frame::before {
  content: "";
  position: absolute;
  top: 8px;
  left: 8px;
  right: 8px;
  bottom: 8px;
  border: 1px solid rgba(255,199,44,0.08);
  pointer-events: none;
}

.l-artifact-card__img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
  filter: saturate(0.6) contrast(1.1);
  transition: filter 0.5s var(--ease-luxury);
}

.l-artifact-card:hover .l-artifact-card__img {
  filter: saturate(0.8) contrast(1.15);
}

.l-artifact-card__content {
  padding: var(--space-md);
}

.l-artifact-card__era {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--l-gold-dim);
  margin-bottom: var(--space-xs);
}

.l-artifact-card__title {
  font-family: var(--font-display);
  font-size: 1.1rem;
  color: var(--l-gold-pale);
  margin-bottom: var(--space-xs);
}

.l-artifact-card__desc {
  font-size: 0.85rem;
  color: var(--l-white-dim);
  line-height: 1.6;
}

.l-artifact-card__tag {
  position: absolute;
  top: 24px;
  right: 24px;
  background: rgba(8,8,8,0.8);
  border: 1px solid var(--l-gold-deep);
  padding: 0.3rem 0.8rem;
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--l-gold-bright);
}

.l-artifact-gallery__nav {
  display: flex;
  justify-content: center;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.l-artifact-gallery__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255,199,44,0.15);
  border: none;
  cursor: pointer;
  transition: all 0.3s var(--ease-luxury);
}

.l-artifact-gallery__dot.is-active {
  background: var(--l-gold-bright);
  box-shadow: 0 0 10px rgba(255,199,44,0.3);
}

/* ═══════════════════════════════════════════════════════════════════════════════
   NEW SECTION: INVITATION GATE — Exclusive Access Portal
   Purpose: Speakeasy-style entry form for high-value prospects
   ═══════════════════════════════════════════════════════════════════════════════ */
.l-invitation-gate {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl) var(--space-md);
  position: relative;
}

.l-invitation-gate__bg {
  position: absolute;
  inset: 0;
  background: 
    radial-gradient(ellipse at 50% 50%, rgba(45,27,78,0.2) 0%, transparent 60%),
    radial-gradient(ellipse at 20% 80%, rgba(96,74,60,0.1) 0%, transparent 40%);
}

.l-invitation-gate__panel {
  position: relative;
  z-index: var(--z-content);
  max-width: 560px;
  width: 100%;
  background: rgba(26,26,26,0.8);
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  border: 1px solid rgba(255,199,44,0.1);
  padding: calc(var(--space-xl) * 1.2) var(--space-lg);
  text-align: center;
}

.l-invitation-gate__panel::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--grad-gold-linear);
}

.l-invitation-gate__seal {
  width: 80px;
  height: 80px;
  margin: 0 auto var(--space-md);
  border: 1px solid rgba(255,199,44,0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.l-invitation-gate__seal svg {
  width: 36px;
  height: 36px;
  stroke: var(--l-gold-bright);
  fill: none;
  stroke-width: 1;
}

.l-invitation-gate__eyebrow {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--l-gold-dim);
  margin-bottom: var(--space-sm);
}

.l-invitation-gate__title {
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  margin-bottom: var(--space-sm);
}

.l-invitation-gate__body {
  font-size: 0.95rem;
  color: var(--l-white-dim);
  margin-bottom: var(--space-lg);
  line-height: 1.7;
}

.l-invitation-gate__form {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.l-invitation-gate__field {
  position: relative;
}

.l-invitation-gate__field input,
.l-invitation-gate__field select,
.l-invitation-gate__field textarea {
  width: 100%;
  padding: 1rem 1.25rem;
  background: rgba(8,8,8,0.5);
  border: 1px solid rgba(255,199,44,0.08);
  color: var(--l-white-warm);
  font-family: var(--font-body);
  font-size: 0.95rem;
  transition: all 0.3s var(--ease-luxury);
}

.l-invitation-gate__field input:focus,
.l-invitation-gate__field select:focus,
.l-invitation-gate__field textarea:focus {
  outline: none;
  border-color: var(--l-gold-deep);
  box-shadow: 0 0 20px rgba(255,199,44,0.05);
}

.l-invitation-gate__field input::placeholder,
.l-invitation-gate__field textarea::placeholder {
  color: var(--l-white-muted);
}

.l-invitation-gate__field label {
  position: absolute;
  top: -8px;
  left: 12px;
  background: var(--l-grey-card);
  padding: 0 8px;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--l-gold-dim);
}

.l-invitation-gate__submit {
  width: 100%;
  padding: 1.25rem;
  margin-top: var(--space-sm);
  font-size: 0.85rem;
  letter-spacing: 0.12em;
}

.l-invitation-gate__trust {
  margin-top: var(--space-md);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  font-size: 0.75rem;
  color: var(--l-white-muted);
}

.l-invitation-gate__trust svg {
  width: 14px;
  height: 14px;
  stroke: var(--l-gold-dim);
  fill: none;
}

/* ═══════════════════════════════════════════════════════════════════════════════
   NEW SECTION: COMPARISON TABLE — Before/After Authority
   Purpose: Side-by-side contrast showing transformation value
   ═══════════════════════════════════════════════════════════════════════════════ */
.l-comparison {
  padding: var(--space-xl) var(--space-md);
}

.l-comparison__header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto var(--space-xl);
}

.l-comparison__table {
  max-width: 1000px;
  margin: 0 auto;
  border: 1px solid rgba(255,199,44,0.06);
}

.l-comparison__row {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  border-bottom: 1px solid rgba(255,199,44,0.04);
}

.l-comparison__row:last-child {
  border-bottom: none;
}

.l-comparison__row--header {
  background: rgba(26,26,26,0.6);
}

.l-comparison__cell {
  padding: var(--space-sm) var(--space-md);
  display: flex;
  align-items: center;
}

.l-comparison__cell--label {
  font-weight: 500;
  color: var(--l-white-warm);
}

.l-comparison__cell--before {
  color: var(--l-white-muted);
  font-size: 0.9rem;
}

.l-comparison__cell--after {
  color: var(--l-gold-pale);
  font-size: 0.9rem;
  background: rgba(255,199,44,0.02);
}

.l-comparison__cell--after strong {
  color: var(--l-gold-bright);
}

.l-comparison__check {
  color: var(--l-gold-bright);
  margin-right: 8px;
}

.l-comparison__x {
  color: var(--l-white-muted);
  margin-right: 8px;
}

.l-comparison__col-header {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--l-gold-dim);
  padding: var(--space-sm) var(--space-md);
}

.l-comparison__col-header--after {
  color: var(--l-gold-bright);
  background: rgba(255,199,44,0.03);
}

@media (max-width: 768px) {
  .l-comparison__row {
    grid-template-columns: 1fr;
    padding: var(--space-sm);
  }
  .l-comparison__cell--before,
  .l-comparison__cell--after {
    padding: 0.5rem 0;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════════
